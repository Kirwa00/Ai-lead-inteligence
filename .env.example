# Database (Supabase recommended — free tier works)
DATABASE_URL="postgresql://user:password@host:5432/a1_lead_intel?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# AI providers — both can be set; workspaces pick active provider in Settings.
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
# Optional overrides (defaults: claude-sonnet-5 / deepseek-chat)
# RESEARCH_MODEL="claude-sonnet-5"
# DEEPSEEK_MODEL="deepseek-chat"
# Server-wide fallback when org has no preference (usually leave as anthropic)
# LLM_PROVIDER="anthropic"
OPENAI_API_KEY=""

# Contact data providers (optional, strongly recommended before charging real
# customers — without them Contact Discovery guesses emails with the LLM).
# APOLLO_API_KEY: people search by company domain (name, title, verified email).
# HUNTER_API_KEY: email deliverability verification + domain-search fallback.
# Each successful lookup is a flat wallet debit at the usual markup; raw costs
# in micro-USD are overridable to match your provider plan.
APOLLO_API_KEY=""
HUNTER_API_KEY=""
# APOLLO_LOOKUP_RAW_MICROS=30000
# HUNTER_LOOKUP_RAW_MICROS=20000
# HUNTER_VERIFY_RAW_MICROS=10000

# Transactional email (Resend). Powers invite, password-reset and
# email-verification messages. Without it those flows still work — the app
# shows the link on screen in development instead of sending it.
# Note: the default "onboarding@resend.dev" sender only delivers to the address
# your Resend account was created with. Verify a domain for real sending.
RESEND_API_KEY=""
# RESEND_FROM_EMAIL="you@yourdomain.com"

# Google sign-in (optional). The "Continue with Google" button only appears
# when BOTH values are set. Authorised redirect URI must be:
#   <your-origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
